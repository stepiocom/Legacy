# ==============================================================================
# Sentinel Suite - Legacy Engine Configuration
# ==============================================================================

NODE_ENV=production
PORT=3002

# ------------------------------------------------------------------------------
# Inbound Linkage (From Pause Extension)
# ------------------------------------------------------------------------------
# The secure token the extension must provide to commit a verified asset
PAUSE_AUTH_TOKEN=generate_a_secure_random_string_here

# ------------------------------------------------------------------------------
# Outbound Linkage: Permanent Archive
# ------------------------------------------------------------------------------
ARCHIVE_ROOT_DIR=./archive
ENABLE_GIT_AUTO_COMMIT=true

# ------------------------------------------------------------------------------
# Outbound Linkage: Network Dispatch
# ------------------------------------------------------------------------------
# Configure external APIs for programmatic distribution
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_ACCESS_TOKEN=your_oauth2_access_token

# Safety toggle to prevent accidental publishing during pipeline testing
DISPATCH_PILOT_MODE=true
